# Скопируй этот файл в .env и заполни своими значениями. .env не коммитится.

GEMINI_API_KEY=your_gemini_api_key_here

# Бесплатный ключ на tavily.com (~1000 запросов/мес) — нужен для ответов на вопросы
# про свежие события/данные, которых Gemini может не знать (новости, курсы и т.п.)
TAVILY_API_KEY=your_tavily_api_key_here

# Порог загрузки VRAM (%), выше которого STT/TTS переключаются на CPU
GPU_LOAD_THRESHOLD=75

# Таймаут простоя в секундах, после которого ассистент "засыпает"
IDLE_TIMEOUT_SECONDS=900

# Опционально: увести кэши моделей (Whisper/Silero, обычно скачиваются в C:\Users\<ты>\.cache)
# на другой диск, если на системном мало места. Укажи свой путь и раскомментируй.
# HF_HOME=D:/sona-cache/huggingface
# TORCH_HOME=D:/sona-cache/torch
